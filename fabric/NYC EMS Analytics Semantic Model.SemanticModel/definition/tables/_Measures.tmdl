		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Outcomes\Disposition
		lineageTag: cab4eaf1-b189-4a6c-8945-b09ab39d2c21

	measure 'Call Type Changed Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    gold_fact_ems_incident[call_type_changed] = TRUE ()
			)
		formatString: #,0
		displayFolder: 06 Classification\Call Type
		lineageTag: 4ac4f1f6-4916-4e6d-adc6-54060d5f9655

	measure 'Call Type Change Percentage' =
			
