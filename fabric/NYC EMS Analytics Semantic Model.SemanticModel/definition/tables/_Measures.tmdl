table _Measures
	lineageTag: 29b5e698-69b9-4450-836a-1823f96a1728

	measure 'Total Incidents' =
			
			SUM ( gold_fact_ems_incident[incident_count] )
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: 86211f7e-c092-4175-8126-de96ab089612

	measure 'Valid Incident Response Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    gold_fact_ems_incident[is_valid_incident_response] = TRUE ()
			)
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: 13f4f8d1-c1a7-4bfd-bf50-0329e4cd05a1

	measure 'Valid Incident Response Percentage' =
			
			DIVIDE (
			    [Valid Incident Response Incidents],
			    [Total Incidents]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Core KPIs
		lineageTag: c22d442a-474a-4d9f-a11d-e932becc94cf

	measure 'Valid Dispatch Response Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    gold_fact_ems_incident[is_valid_dispatch_response] = TRUE ()
			)
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: fbb80218-3eee-4052-88c8-fc679b893ae7

	measure 'Total Incident Response Seconds' =
			
			SUM (
			    gold_fact_ems_incident[valid_incident_response_seconds]
			)
		formatString: #,0.00
		isHidden
		displayFolder: 02 Response Performance
		lineageTag: 1a39d58e-5d0b-497a-af29-6cf0d4225e52

	measure 'Average Incident Response Minutes' =
			
			DIVIDE (
			    [Total Incident Response Seconds],
			    [Valid Incident Response Incidents] * 60.0
			)
		formatString: 0.00
		displayFolder: 02 Response Performance
		lineageTag: 78759529-7345-4ab4-80e3-b6f18c6122c9

	measure 'Total Dispatch Response Seconds' =
			
			SUM (
			    gold_fact_ems_incident[valid_dispatch_response_seconds]
			)
		formatString: #,0.00
		isHidden
		displayFolder: 02 Response Performance
		lineageTag: 8636e522-9952-4a30-ae6b-b41202e16afe

	measure 'Average Dispatch Response Minutes' =
			
			DIVIDE (
			    [Total Dispatch Response Seconds],
			    [Valid Dispatch Response Incidents] * 60.0
			)
		formatString: 0.00
		displayFolder: 02 Response Performance
		lineageTag: 6d272dc4-87d6-48d0-97c2-277a314cf456

	measure 'Valid Travel Time Incidents' =
			
			COUNT (
			    gold_fact_ems_incident[valid_travel_time_seconds]
			)
		formatString: #,0
		displayFolder: 01 Core KPIs
		lineageTag: d55a495a-7c6e-4b6e-9943-cd1591f01609

	measure 'Total Travel Time Seconds' =
			
			SUM (
			    gold_fact_ems_incident[valid_travel_time_seconds]
			)
		formatString: #,0.00
		isHidden
		displayFolder: 02 Response Performance
		lineageTag: 545bbad7-194e-4390-a5e5-3c6f973332c6

	measure 'Average Travel Time Minutes' =
			
			DIVIDE (
			    [Total Travel Time Seconds],
			    [Valid Travel Time Incidents] * 60.0
			)
		formatString: 0.00
		displayFolder: 02 Response Performance
		lineageTag: 97d9eee6-0331-4743-8dfb-756a53e8f7ee

	measure 'Dispatch Time Share Percentage' =
			
			DIVIDE (
			    [Complete Sample Dispatch Seconds],
			    [Complete Sample Incident Response Seconds]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Response Performance\Components
		lineageTag: 878c277c-294f-4c89-b95e-07f1da2344d7

	measure 'Travel Time Share Percentage' =
			
			DIVIDE (
			    [Complete Sample Travel Seconds],
			    [Complete Sample Incident Response Seconds]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Response Performance\Components
		lineageTag: 965c3fbc-7221-4889-bfd4-53a4e4d561a7

	measure 'Complete Response Component Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    gold_fact_ems_incident[valid_dispatch_response_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_travel_time_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_incident_response_seconds] <> BLANK ()
			)
		formatString: #,0
		displayFolder: 02 Response Performance\Components
		lineageTag: fc4fbc37-2f7e-4f14-8a0c-0251e7d956a0

	measure 'Complete Sample Dispatch Seconds' =
			
			CALCULATE (
			    SUM (
			        gold_fact_ems_incident[valid_dispatch_response_seconds]
			    ),
			    gold_fact_ems_incident[valid_dispatch_response_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_travel_time_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_incident_response_seconds] <> BLANK ()
			)
		formatString: 0.00
		isHidden
		displayFolder: 02 Response Performance\Components
		lineageTag: 84e628e6-0fc4-4bf3-9e51-1a230e199433

	measure 'Complete Sample Travel Seconds' =
			
			CALCULATE (
			    SUM (
			        gold_fact_ems_incident[valid_travel_time_seconds]
			    ),
			    gold_fact_ems_incident[valid_dispatch_response_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_travel_time_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_incident_response_seconds] <> BLANK ()
			)
		formatString: 0.00
		isHidden
		displayFolder: 02 Response Performance\Components
		lineageTag: d2738626-eb30-49e1-86d8-67f1910f50d4

	measure 'Complete Sample Incident Response Seconds' =
			
			CALCULATE (
			    SUM (
			        gold_fact_ems_incident[valid_incident_response_seconds]
			    ),
			    gold_fact_ems_incident[valid_dispatch_response_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_travel_time_seconds] <> BLANK (),
			    gold_fact_ems_incident[valid_incident_response_seconds] <> BLANK ()
			)
		formatString: 0.00
		isHidden
		displayFolder: 02 Response Performance\Components
		lineageTag: c45005b8-19f0-40ac-a3e6-32de019b4d34

	measure 'Response Component Difference Seconds' = ```
			
			    [Complete Sample Incident Response Seconds]
			        - [Complete Sample Dispatch Seconds]
			        - [Complete Sample Travel Seconds]
			```
		formatString: 0.00
		isHidden
		displayFolder: 07 Data Quality
		lineageTag: 51c4209d-4efd-44bd-9819-c15ab65cdb34

	measure 'Response Component Share Total' = ```
			
			    [Dispatch Time Share Percentage]
			        + [Travel Time Share Percentage]
			```
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		displayFolder: 07 Data Quality
		lineageTag: ab9e7874-22d2-4d8f-b76a-5aaa2c62c7f9

	measure 'Population Std Dev Response Minutes' =
			
			VAR ValidResponses =
			    FILTER (
			        gold_fact_ems_incident,
			        NOT ISBLANK (
			            gold_fact_ems_incident[valid_incident_response_seconds]
			        )
			    )
			RETURN
			    STDEVX.P (
			        ValidResponses,
			        gold_fact_ems_incident[valid_incident_response_seconds] / 60.0
			    )
		formatString: 0.00
		displayFolder: 03 Reliability\Distribution
		lineageTag: 29f01b94-45d5-46bf-a954-11a1c0061529

	measure 'Response CV Percentage' =
			
			DIVIDE (
			    [Population Std Dev Response Minutes],
			    [Average Incident Response Minutes]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Reliability\Distribution
		lineageTag: bfea230d-a099-4084-9e29-e922329a6163

	measure 'P90 Response Minutes' =
			
			VAR ValidResponses =
			    FILTER (
			        gold_fact_ems_incident,
			        NOT ISBLANK (
			            gold_fact_ems_incident[valid_incident_response_seconds]
			        )
			    )
			RETURN
			    PERCENTILEX.INC (
			        ValidResponses,
			        gold_fact_ems_incident[valid_incident_response_seconds] / 60.0,
			        0.90
			    )
		formatString: 0.00
		displayFolder: 03 Reliability\Distribution
		lineageTag: 696b01dd-e6bb-4fe6-8357-b6f3e7697854

	measure 'P95 Response Minutes' =
			
			VAR ValidResponses =
			    FILTER (
			        gold_fact_ems_incident,
			        NOT ISBLANK (
			            gold_fact_ems_incident[valid_incident_response_seconds]
			        )
			    )
			RETURN
			    PERCENTILEX.INC (
			        ValidResponses,
			        gold_fact_ems_incident[valid_incident_response_seconds] / 60.0,
			        0.95
			    )
		formatString: 0.00
		displayFolder: 03 Reliability\Distribution
		lineageTag: 2cfa9de0-d5ab-4d94-ae9b-945fc207c969

	measure 'Held Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    gold_fact_ems_incident[is_held] = TRUE ()
			)
		formatString: #,0
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: 50f6941c-a234-483f-bbd1-e1d3df82840c

	measure 'Held Incident Percentage' =
			
			DIVIDE (
			    [Held Incidents],
			    [Total Incidents]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: ac72d15a-cd14-43c4-9b78-bb9fc61ce307

	measure 'Average Held Response Minutes' =
			
			CALCULATE (
			    [Average Incident Response Minutes],
			    gold_fact_ems_incident[is_held] = TRUE ()
			)
		formatString: 0.00
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: c468d3fc-94d0-4370-b748-9988dd647007

	measure 'Average Non-Held Response Minutes' =
			
