	measure 'Final Call Type Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    CROSSFILTER (
			        gold_fact_ems_incident[initial_call_type_key],
			        gold_dim_call_type[call_type_key],
			        NONE
			    ),
			    USERELATIONSHIP (
			        gold_fact_ems_incident[final_call_type_key],
			        gold_dim_call_type[call_type_key]
			    )
			)
		formatString: #,0
		displayFolder: 06 Classification\Call Type
		lineageTag: 6ec88a4e-4509-4545-9f0b-959f1c425a7c

	measure 'Final Severity Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    CROSSFILTER (
			        gold_fact_ems_incident[initial_severity_key],
			        gold_dim_severity[severity_key],
			        NONE
			    ),
			    USERELATIONSHIP (
			        gold_fact_ems_incident[final_severity_key],
			        gold_dim_severity[severity_key]
			    )
			)
		formatString: #,0
		displayFolder: 06 Classification\Severity
		lineageTag: 6964ef64-4b13-44c3-aac6-f1953c7038a4

	measure 'Final Call Type Incident Percentage' =
			
			DIVIDE (
			    [Final Call Type Incidents],
			    CALCULATE (
			        [Final Call Type Incidents],
			        REMOVEFILTERS (
			            gold_dim_call_type
			        )
			    )
			)
		formatString: 0.00000%;-0.00000%;0.00000%
		displayFolder: 06 Classification\Call Type
		lineageTag: 9619be61-0734-470b-aa3a-2dd07afa73bc

	measure 'Final Severity Incident Percentage' =
			
			DIVIDE (
			    [Final Severity Incidents],
			    CALCULATE (
			        [Final Severity Incidents],
			        REMOVEFILTERS (
			            gold_dim_severity
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 06 Classification\Severity
		lineageTag: c80f5808-a4f9-49ea-8040-6a63d7147cf9

	measure 'Final Call Type Rank' =
			
			VAR CurrentFinalCallTypeIncidents =
			    [Final Call Type Incidents]
			RETURN
			    IF (
			        NOT ISINSCOPE (
			            gold_dim_call_type[call_type]
			        )
			            || ISBLANK ( CurrentFinalCallTypeIncidents ),
			        BLANK (),
			        RANKX (
			            ALLSELECTED (
			                gold_dim_call_type[call_type],
			                gold_dim_call_type[call_type_description]
			            ),
			            [Final Call Type Incidents],
			            CurrentFinalCallTypeIncidents,
			            DESC,
			            DENSE
			        )
			    )
		formatString: 0
		displayFolder: 06 Classification\Call Type
		lineageTag: 43d80f69-8074-47e4-adc4-d68bdcdfca78

	measure 'Final Severity Rank' =
			
			VAR CurrentSeverityIncidents =
			    [Final Severity Incidents]
			RETURN
			    IF (
			        NOT ISINSCOPE (
			            gold_dim_severity[severity_label]
			        )
			            || ISBLANK ( CurrentSeverityIncidents ),
			        BLANK (),
			        RANKX (
			            ALLSELECTED (
			                gold_dim_severity[severity_label],
			                gold_dim_severity[severity_level_code]
			            ),
			            [Final Severity Incidents],
			            CurrentSeverityIncidents,
			            DESC,
			            DENSE
			        )
			    )
		formatString: 0
		displayFolder: 06 Classification\Severity
		lineageTag: f18464fb-68e7-477e-b428-adf78768a9d0

	measure 'Analyzable Daily Performance Groups' =
			
			CALCULATE (
			    COUNTROWS (
			        gold_agg_daily_performance
			    ),
			    gold_agg_daily_performance[has_sufficient_sample] = TRUE (),
			    gold_agg_daily_performance[has_sufficient_baseline] = TRUE ()
			)
		formatString: #,0
		displayFolder: 03 Reliability\Control Limits
		lineageTag: 7ff4c806-7465-48b9-9da3-740cde425a9e

	measure 'Reportable Response Anomaly Groups' =
			
			CALCULATE (
			    COUNTROWS (
			        gold_agg_daily_performance
			    ),
			    gold_agg_daily_performance[is_reportable_response_anomaly] = TRUE ()
			)
		formatString: #,0
		displayFolder: 03 Reliability\Control Limits
		lineageTag: 827b5343-7ce0-49e5-9211-af19cf1358f1

	measure 'Reportable Anomaly Percentage' =
			
			DIVIDE (
			    [Reportable Response Anomaly Groups],
			    [Analyzable Daily Performance Groups]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Reliability\Control Limits
		lineageTag: 5dab1348-f5d6-4f1f-9be7-368e5b07ecc7

	measure 'Above Upper Control Limit Groups' =
			
			CALCULATE (
			    COUNTROWS (
			        gold_agg_daily_performance
			    ),
			    gold_agg_daily_performance[is_reportable_response_anomaly] = TRUE (),
			    gold_agg_daily_performance[is_above_upper_control_limit] = TRUE ()
			)
		formatString: 0
		displayFolder: 03 Reliability\Control Limits
		lineageTag: a3007505-5ffc-4c7d-be39-7aea9d9442bf

	measure 'Below Lower Control Limit Groups' =
			
			CALCULATE (
			    COUNTROWS (
			        gold_agg_daily_performance
			    ),
			    gold_agg_daily_performance[is_reportable_response_anomaly] = TRUE (),
			    gold_agg_daily_performance[is_below_lower_control_limit] = TRUE ()
			)
		formatString: 0
		displayFolder: 03 Reliability\Control Limits
		lineageTag: fc6b5733-ae0a-4516-b6de-c5c1d4a4fa6c

	measure 'Daily Performance Average Response Minutes' =
			
			DIVIDE (
			    SUM (
			        gold_agg_daily_performance[total_incident_response_seconds]
			    ),
			    SUM (
			        gold_agg_daily_performance[valid_incident_response_count]
			    ) * 60.0
			)
		formatString: 0.00
		displayFolder: 03 Reliability\Control Limits
		lineageTag: ab462c38-5ef4-46bd-bca7-39fc23383eba

	measure 'Daily Aggregate Incidents' =
			
			SUM (
			    gold_agg_daily_performance[total_incidents]
			)
		formatString: #,0
		displayFolder: 04 Demand\Demand and Response
		lineageTag: 907b8d76-eed4-4c07-b41f-da88bc5babeb

	measure 'P75 Daily Demand Threshold' =
			
			PERCENTILEX.INC (
			    ALLSELECTED (
			        gold_dim_date[full_date]
			    ),
			    CALCULATE (
			        [Daily Aggregate Incidents]
			    ),
			    0.75
			)
		formatString: #,0.00
		isHidden
		displayFolder: 04 Demand\Demand and Response
		lineageTag: a150540a-38d1-429f-a814-8e2dbdb51d46

	measure 'Selected Period Average Response Minutes' =
			
			AVERAGEX (
			    ALLSELECTED (
			        gold_dim_date[full_date]
			    ),
			    CALCULATE (
			        [Daily Performance Average Response Minutes]
			    )
			)
		formatString: 0.00
		isHidden
		displayFolder: 04 Demand\Demand and Response
		lineageTag: c49a4b48-debc-4254-a404-8e237f29f682

	measure 'High Demand Slow Response Flag' =
			
			VAR CurrentDailyDemand =
			    [Daily Aggregate Incidents]
			VAR CurrentDailyResponse =
			    [Daily Performance Average Response Minutes]
			VAR HighDemandThreshold =
			    [P75 Daily Demand Threshold]
			VAR SlowResponseThreshold =
			    [Selected Period Average Response Minutes]
			RETURN
			    IF (
			        NOT ISINSCOPE (
			            gold_dim_date[full_date]
			        ),
			        BLANK (),
			        IF (
			            NOT ISBLANK ( CurrentDailyDemand )
			                && NOT ISBLANK ( CurrentDailyResponse )
			                && CurrentDailyDemand >= HighDemandThreshold
			                && CurrentDailyResponse > SlowResponseThreshold,
			            1,
			            0
			        )
			    )
		formatString: 0
		displayFolder: 04 Demand\Demand and Response
		lineageTag: 7e74fd81-e866-4177-8773-21d7ff4e4a54

	measure 'High Demand Slow Response Days' =
			
			VAR HighDemandThreshold =
			    [P75 Daily Demand Threshold]
			VAR SlowResponseThreshold =
			    [Selected Period Average Response Minutes]
			VAR SelectedDates =
			    ALLSELECTED (
			        gold_dim_date[full_date]
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            SelectedDates,
			            VAR DailyDemand =
			                CALCULATE (
			                    [Daily Aggregate Incidents]
			                )
			            VAR DailyResponse =
			                CALCULATE (
			                    [Daily Performance Average Response Minutes]
			                )
			            RETURN
			                NOT ISBLANK ( DailyDemand )
			                    && NOT ISBLANK ( DailyResponse )
			                    && DailyDemand >= HighDemandThreshold
			                    && DailyResponse > SlowResponseThreshold
			        )
			    )
		formatString: 0
		displayFolder: 04 Demand\Demand and Response
		lineageTag: 8c1c4acf-3054-4cca-a389-6a25c63b0be9

	measure 'High Demand Slow Response Day Percentage' =
			
			DIVIDE (
			    [High Demand Slow Response Days],
			    [Selected Calendar Days]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Demand\Demand and Response
		lineageTag: 0d78923b-5510-422e-8180-b4b748538e9e

	measure 'Selected Period Response Center Line Minutes' =
			
			VAR SelectedDates =
			    CALCULATETABLE (
			        VALUES ( gold_dim_date[full_date] ),
			        ALLSELECTED ( gold_dim_date[full_date] )
			    )
			VAR DailyValues =
			    FILTER (
			        ADDCOLUMNS (
			            SelectedDates,
			            "@DailyAverage",
			                CALCULATE (
			                    [Daily Performance Average Response Minutes]
			                )
			        ),
			        NOT ISBLANK ( [@DailyAverage] )
			    )
			RETURN
			    AVERAGEX (
			        DailyValues,
			        [@DailyAverage]
			    )
		formatString: 0.00
		displayFolder: 03 Reliability\Control Limits
		lineageTag: d2844aa8-65db-4630-bc6e-4f1c7a985c32

	measure 'Selected Period Upper Control Limit Minutes' =
			
			VAR SelectedDates =
			    CALCULATETABLE (
			        VALUES ( gold_dim_date[full_date] ),
			        ALLSELECTED ( gold_dim_date[full_date] )
			    )
			VAR DailyValues =
			    FILTER (
			        ADDCOLUMNS (
			            SelectedDates,
			            "@DailyAverage",
			                CALCULATE (
			                    [Daily Performance Average Response Minutes]
			                )
			        ),
			        NOT ISBLANK ( [@DailyAverage] )
			    )
			VAR CenterLine =
			    AVERAGEX (
			        DailyValues,
			        [@DailyAverage]
			    )
			VAR DailyStdDev =
			    STDEVX.P (
			        DailyValues,
			        [@DailyAverage]
			    )
			RETURN
			    IF (
			        COUNTROWS ( DailyValues ) >= 2,
			        CenterLine + 3 * DailyStdDev
			    )
		formatString: 0.00
		displayFolder: 03 Reliability\Control Limits
		lineageTag: 99295ace-b6cb-4a52-bcf5-c179b14e6a4f

	measure 'Selected Period Lower Control Limit Minutes' =
			
			VAR SelectedDates =
			    CALCULATETABLE (
			        VALUES ( gold_dim_date[full_date] ),
			        ALLSELECTED ( gold_dim_date[full_date] )
			    )
			VAR DailyValues =
			    FILTER (
			        ADDCOLUMNS (
			            SelectedDates,
			            "@DailyAverage",
			                CALCULATE (
			                    [Daily Performance Average Response Minutes]
			                )
			        ),
			        NOT ISBLANK ( [@DailyAverage] )
			    )
			VAR CenterLine =
			    AVERAGEX (
			        DailyValues,
			        [@DailyAverage]
			    )
			VAR DailyStdDev =
			    STDEVX.P (
			        DailyValues,
			        [@DailyAverage]
			    )
			RETURN
			    IF (
			        COUNTROWS ( DailyValues ) >= 2,
			        MAX (
			            0,
			            CenterLine - 3 * DailyStdDev
			        )
			    )
		formatString: 0.00
		displayFolder: 03 Reliability\Control Limits
		lineageTag: d19dee63-d1ab-474e-bbca-7ce13ebb61c3

	column 'Measure Holder'
		isHidden
		formatString: 0
		lineageTag: 73bf6a89-f821-402e-9aab-833387846b1f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Measure Holder]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =
				DATATABLE (
				    "Measure Holder",
				    INTEGER,
				    {
				        { 1 }
				    }
				)

	annotation PBI_Id = a1038756e6f34f369f491d355d89ac35

