			    [Average Incident Response Minutes],
			    gold_fact_ems_incident[is_held] = FALSE ()
			)
		formatString: 0.00
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: e24260df-2b72-4159-931c-4aa234abaf79

	measure 'Held Response Difference Minutes' = ```
			
			    [Average Held Response Minutes]
			        - [Average Non-Held Response Minutes]
			```
		formatString: 0.00
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: 1181baeb-acae-4739-b938-4aadad4f9361

	measure 'Held Response Difference Percentage' =
			
			DIVIDE (
			    [Held Response Difference Minutes],
			    [Average Non-Held Response Minutes]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: f4ad985d-a070-4a03-9b21-1cd9a174293f

	measure 'Held Response Std Dev Minutes' =
			
			CALCULATE (
			    [Population Std Dev Response Minutes],
			    gold_fact_ems_incident[is_held] = TRUE ()
			)
		formatString: 0.00
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: 035ba773-77a7-4023-9e5c-5c33cfe9843b

	measure 'Non-Held Response Std Dev Minutes' =
			
			CALCULATE (
			    [Population Std Dev Response Minutes],
			    gold_fact_ems_incident[is_held] = FALSE ()
			)
		formatString: 0.00
		displayFolder: 03 Reliability\Held Incidents
		lineageTag: 5ac3d3e5-deb4-4c93-854a-4f0f133c1fbc

	measure 'Incidents Previous Year' =
			
			IF (
			    HASONEVALUE (
			        gold_dim_date[year]
			    ),
			    CALCULATE (
			        [Total Incidents],
			        DATEADD (
			            gold_dim_date[full_date],
			            -1,
			            YEAR
			        )
			    )
			)
		formatString: #,0
		displayFolder: 04 Demand\Time Trends
		lineageTag: bad7e02b-1dc1-435f-b8c0-cc37146b667c

	measure 'Incident YoY Change' =
			
			VAR CurrentIncidents =
			    [Total Incidents]
			VAR PreviousIncidents =
			    [Incidents Previous Year]
			RETURN
			    IF (
			        HASONEVALUE (
			            gold_dim_date[year]
			        )
			            && NOT ISBLANK ( PreviousIncidents ),
			        CurrentIncidents - PreviousIncidents,
			        BLANK ()
			    )
		formatString: #,0
		displayFolder: 04 Demand\Time Trends
		lineageTag: 61bca536-9c8c-4052-a262-be2000780436

	measure 'Incident YoY Change Percentage' =
			
			VAR PreviousIncidents =
			    [Incidents Previous Year]
			RETURN
			    IF (
			        HASONEVALUE (
			            gold_dim_date[year]
			        )
			            && NOT ISBLANK ( PreviousIncidents ),
			        DIVIDE (
			            [Total Incidents] - PreviousIncidents,
			            PreviousIncidents
			        ),
			        BLANK ()
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Demand\Time Trends
		lineageTag: 4601a351-a8a6-4ec1-8522-9390723167d6

	measure 'Selected Calendar Days' =
			
			COUNTROWS (
			    VALUES (
			        gold_dim_date[full_date]
			    )
			)
		formatString: 0
		isHidden
		displayFolder: 04 Demand\Supporting Measures
		lineageTag: 3f04304b-3653-42aa-a979-52cfb3d92a58

	measure 'Average Daily Incidents' =
			
			DIVIDE (
			    [Total Incidents],
			    [Selected Calendar Days]
			)
		formatString: #,0.00
		displayFolder: 04 Demand\Daily Demand
		lineageTag: b3cf4075-d6b3-4d30-a8af-d6ebb164fb2b

	measure 'Peak Daily Incidents' =
			
			MAXX (
			    VALUES (
			        gold_dim_date[full_date]
			    ),
			    CALCULATE (
			        [Total Incidents]
			    )
			)
		formatString: #,0
		displayFolder: 04 Demand\Daily Demand
		lineageTag: 0bc0e2c6-942a-4b3f-b94a-5f1ad2e2c5fe

	measure 'Day of Week Incident Percentage' =
			
			DIVIDE (
			    [Total Incidents],
			    CALCULATE (
			        [Total Incidents],
			        REMOVEFILTERS (
			            gold_dim_date[day_of_week_name],
			            gold_dim_date[day_of_week_short_name],
			            gold_dim_date[day_of_week_number]
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Demand\Demand Distribution
		lineageTag: 239f7383-f3ba-42b0-95fa-e8b4deecee06

	measure 'Hour Incident Percentage' =
			
			DIVIDE (
			    [Total Incidents],
			    CALCULATE (
			        [Total Incidents],
			        REMOVEFILTERS (
			            gold_dim_time
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Demand\Demand Distribution
		lineageTag: a57be10a-6554-4861-93f7-3132384d6b18

	measure 'Time of Day Incident Percentage' =
			
			DIVIDE (
			    [Total Incidents],
			    CALCULATE (
			        [Total Incidents],
			        REMOVEFILTERS (
			            gold_dim_time
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 04 Demand\Demand Distribution
		lineageTag: 46b6c69f-7005-43ef-ab81-9fc7610b0140

	measure 'Borough Incident Percentage' =
			
			DIVIDE (
			    [Total Incidents],
			    CALCULATE (
			        [Total Incidents],
			        REMOVEFILTERS (
			            gold_dim_geography
			        )
			    )
			)
		formatString: 0.0000%;-0.0000%;0.0000%
		displayFolder: 04 Demand\Geography
		lineageTag: 63ce56ba-23d7-4d6b-962b-41655735d2d1

	measure 'Initial Call Type Incident Percentage' =
			
			DIVIDE (
			    [Total Incidents],
			    CALCULATE (
			        [Total Incidents],
			        REMOVEFILTERS (
			            gold_dim_call_type
			        )
			    )
			)
		formatString: 0.00000%;-0.00000%;0.00000%
		displayFolder: 04 Demand\Call Types
		lineageTag: 67404073-4223-4804-a3e3-3a9943b3764e

	measure 'Initial Call Type Rank' =
			
			VAR CurrentInitialCallTypeIncidents =
			    [Total Incidents]
			RETURN
			    IF (
			        NOT ISINSCOPE (
			            gold_dim_call_type[call_type]
			        )
			            || ISBLANK ( CurrentInitialCallTypeIncidents ),
			        BLANK (),
			        RANKX (
			            ALLSELECTED (
			                gold_dim_call_type[call_type]
			            ),
			            CALCULATE (
			                [Total Incidents],
			                REMOVEFILTERS (
			                    gold_dim_call_type[call_type_description]
			                )
			            ),
			            CurrentInitialCallTypeIncidents,
			            DESC,
			            DENSE
			        )
			    )
		formatString: 0
		displayFolder: 04 Demand\Call Types
		lineageTag: fbf0495c-b2bd-455c-84d7-395bf29cffe0

	measure 'Disposition Incident Percentage' =
			
			DIVIDE (
			    [Total Incidents],
			    CALCULATE (
			        [Total Incidents],
			        REMOVEFILTERS (
			            gold_dim_disposition
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 05 Outcomes\Disposition
		lineageTag: d6b9ce48-09f3-4ac4-b419-d50dd09e5f60

	measure 'Transported Incidents' =
			
			CALCULATE (
			    [Total Incidents],
			    gold_dim_disposition[disposition_category] = "Transported"
			)
		formatString: #,0
		displayFolder: 05 Outcomes\Disposition
		lineageTag: a3aa877b-d861-4548-92d6-67e876fc3f70

	measure 'Transported Incident Percentage' =
			
